# Required only for `npm run predict`.
TYPESAFE_API_KEY=replace_with_your_typesafe_api_key

# Optional TypeSafe overrides.
# TYPESAFE_DEFAULT_MODEL=jev-latest
# TYPESAFE_BASE_URL=https://api.typesafe.ai

# Optional: how long to watch Binance's public BTC liquidation stream per run.
# Default: 3000; set to 0 to skip the observation.
LIQUIDATION_WINDOW_MS=3000

# Continuous experiment settings.
# Wait this long after each UTC 15-minute boundary before collecting the snapshot.
BOUNDARY_DELAY_MS=10000
# Poll for just-closed Binance candles for up to this long before failing the boundary.
CANDLE_FINALIZATION_TIMEOUT_MS=60000
# Store JSONL logs and generated reports here. Relative paths use the project directory.
EXPERIMENT_DATA_DIR=data
